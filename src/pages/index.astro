// Split so the full address never appears in the HTML; assembled client-side.
const emailUser = "hello";
const emailDomain = "dtsoi.com";
const linkedin = "https://www.linkedin.com/in/denistsoi";

const nav = [
  { href: "#why", label: "01 WHY ME" },
  { href: "#work", label: "02 DEPLOYMENTS" },
  { href: "#experience", label: "03 EXPERIENCE" },
  { href: "#community", label: "04 COMMUNITY" },
  { href: "#contact", label: "05 CONTACT" },
];

