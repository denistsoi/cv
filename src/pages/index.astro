      .contact-links a {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding: 14px 0;
        min-height: 44px;
        border-bottom: 1px solid var(--ground);
        font-size: 12px;
        letter-spacing: 0.16em;
      }

      /* Footer */
      .foot {
        border-top: 1px solid var(--ink);
      }
      .foot-in {
        padding-block: 20px;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 12px;
        font-size: 10px;
        letter-spacing: 0.28em;
      }

      /* Motion */
      .m-on .ul {
        transition: background-size 0.3s cubic-bezier(0.2, 0.7, 0, 1);
      }
      .m-on .card {
        transition:
          outline-offset 0.25s cubic-bezier(0.2, 0.7, 0, 1),
          outline-color 0.25s;
      }
      .m-on .xrow .mk {
        transition: opacity 0.2s;
      }
      .m-on .talk {
        transition:
          background-color 0.15s,
          color 0.15s;
      }
      .m-on .blink {
        animation: blink 1.6s steps(1) infinite;
      }
      .m-on .boot {
        animation: boot 0.6s steps(6) both;
      }
      .m-on .draw {
        transform-origin: left;
        animation: draw 0.9s cubic-bezier(0.2, 0.7, 0, 1) both;
      }
      .m-on .card:hover .d1 {
        animation: float 3s ease-in-out infinite;
      }
      .m-on .card:hover .d2 {
        animation: ship 3s ease-in-out infinite alternate;
      }
      .m-on .card:hover .d3 {
        animation: spin 14s linear infinite;
      }
      .m-on .card:hover .d4 {
        animation: float 3s ease-in-out infinite;
      }
      .m-on .card:hover .d5 {
        transform-origin: 50% 92%;
        animation: wobble 1.2s ease-in-out infinite;
      }
      .m-on .card:hover .d6 {
        animation: pan 4s ease-in-out infinite alternate;
      }
      @keyframes pan {
        from {
          transform: scale(1.12) translateX(-3%);
        }
        to {
          transform: scale(1.12) translateX(3%);
        }
      }
      @keyframes wobble {
        0%,
        100% {
          transform: rotate(-2.5deg);
        }
        50% {
          transform: rotate(2.5deg);
        }
      }
      @keyframes float {
        0%,
        100% {
          transform: translateY(0) scale(1.03);
        }
        50% {
          transform: translateY(-8px) scale(1.08);
        }
      }
      @keyframes ship {
        from {
          transform: scale(1.15) translateX(4%);
        }
        to {
          transform: scale(1.15) translateX(-6%);
        }
      }
      @keyframes spin {
        from {
          transform: scale(1.25) rotate(0deg);
        }
        to {
          transform: scale(1.25) rotate(360deg);
        }
      }
      @keyframes blink {
        50% {
          opacity: 0;
        }
      }
      @keyframes boot {
        from {
          clip-path: inset(0 100% 0 0);
        }
        to {
          clip-path: inset(0 0 0 0);
        }
      }
      @keyframes draw {
        from {
          transform: scaleX(0);
        }
        to {
          transform: scaleX(1);
        }
      }
      @supports (animation-timeline: view()) {
        .m-on .scan {
          position: relative;
        }
        .m-on .scan::after {
          content: "";
          position: absolute;
          left: 0;
          right: 0;
          top: 0;
          height: 1px;
          background: var(--ink);
          pointer-events: none;
          animation: scan linear both;
          animation-timeline: view();
          animation-range: entry 0% cover 50%;
        }
        .m-on .rv {
          animation: rv linear both;
          animation-timeline: view();
          animation-range: entry 0% entry 70%;
        }
        @keyframes scan {
          from {
            top: 0;
            opacity: 1;
          }
          to {
            top: 100%;
            opacity: 0;
          }
        }
        @keyframes rv {
          from {
            clip-path: inset(0 0 100% 0);
          }
          to {
            clip-path: inset(0 0 0 0);
          }
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .m-on *,
        .m-on *::after {
          animation: none !important;
          transition: none !important;
        }
      }
    </style>
  </body>
</html>
