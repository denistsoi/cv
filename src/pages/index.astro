    <script>
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // Assemble email links (kept out of the HTML to deter scrapers)
      document.querySelectorAll<HTMLAnchorElement>("a[data-u][data-d]").forEach((a) => {
        const addr = `${a.dataset.u}@${a.dataset.d}`;
        a.href = `mailto:${addr}`;
        const text = a.querySelector<HTMLElement>("[data-email-text]");
        if (text) text.textContent = addr.toUpperCase();
      });

      // Sydney clock
      const clock = document.getElementById("clock");
      const fmt = () => {
        try {
          return new Intl.DateTimeFormat("en-AU", {
            timeZone: "Australia/Sydney",
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit",
            hour12: false,
          }).format(new Date());
        } catch {
          return "";
        }
      };
      if (clock) {
        clock.textContent = fmt();
        setInterval(() => (clock.textContent = fmt()), 1000);
      }

      // Name decode on load
      const nameEl = document.getElementById("name");
      if (nameEl && !reduce) {
        const target = "DENIS\nTSOI";
        const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/#<>";
        let f = 0;
        const t = setInterval(() => {
          f++;
          const done = Math.floor(f / 2);
          if (done >= target.length) {
            clearInterval(t);
            nameEl.textContent = target;
            return;
          }
          let out = "";
          for (let i = 0; i < target.length; i++) {
            const c = target[i];
            out +=
              i < done || c === " " || c === "\n"
                ? c
                : chars[Math.floor(Math.random() * chars.length)];
          }
          nameEl.textContent = out;
        }, 45);
      }

      // Light / dark toggle (remembered per visitor)
      const root = document.documentElement;
      const btn = document.getElementById("modeBtn");
      const apply = (light: boolean) => {
        root.classList.toggle("light", light);
        const next = `Switch to ${light ? "dark" : "light"} mode`;
        btn?.setAttribute("aria-label", next);
        btn?.setAttribute("title", next);
      };
      apply(root.classList.contains("light"));
      btn?.addEventListener("click", () => {
        const light = !root.classList.contains("light");
        apply(light);
        try {
          localStorage.setItem("theme", light ? "light" : "dark");
        } catch {}
      });

      // Close mobile menu after choosing a link
      document.querySelectorAll<HTMLAnchorElement>(".navc-menu a").forEach((a) =>
        a.addEventListener("click", () => a.closest("details")?.removeAttribute("open")),
      );
    </script>

