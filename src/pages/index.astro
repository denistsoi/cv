  },
];

const links = [
  { k: "EMAIL", v: "HELLO AT DTSOI.COM", href: "#contact", email: true },
  { k: "LINKEDIN", v: "/IN/DENISTSOI", href: linkedin },
  { k: "GITHUB", v: "DENISTSOI.GITHUB.IO", href: "https://denistsoi.github.io/" },
  { k: "WEB", v: "DTSOI.COM", href: "https://dtsoi.com" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="I embed with customers and turn rough specs into systems that run in production for years."
    />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Michroma&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
    <script is:inline>
      try {
        if (localStorage.getItem("theme") === "light")
          document.documentElement.classList.add("light");
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="hud m-on">
      <!-- STICKY TOP BAR -->
      <header class="topbar">
        <div class="wrap topbar-in boot">
          <div class="brand">
            <div class="brand-mark">DENIS TSOI</div>
            <div class="hsub">FORWARD DEPLOYED ENGINEER</div>
          </div>
          <nav class="navf">
            {nav.map((n) => <a class="ul" href={n.href}>{n.label}</a>)}
          </nav>
          <div class="tools">
            <a class="hbadge ul" href="#contact">
              <span class="blink sq"></span>
              <span>AVAILABLE Q4 2026</span>
            </a>
            <span class="hclock">SYD <span id="clock">--:--:--</span></span>
            <button type="button" id="modeBtn" class="btn-line btn-icon" aria-label="Switch to light mode" title="Switch to light mode">
              <svg width="14" height="14" viewBox="0 0 12 12" aria-hidden="true"
                ><circle cx="6" cy="6" r="5.25" fill="none" stroke="currentColor" stroke-width="1.5"
                ></circle><path d="M6 0.75a5.25 5.25 0 0 1 0 10.5z" fill="currentColor"></path></svg
              >
            </button>
            <details class="navc">
              <summary class="btn-line">
                <svg width="14" height="10" viewBox="0 0 14 10" fill="none" stroke="currentColor" stroke-width="1.5"
                  ><path d="M0 1h14M0 5h14M0 9h14"></path></svg
                >MENU
              </summary>
              <nav class="navc-menu">
                {nav.map((n) => <a href={n.href}>{n.label}</a>)}
              </nav>
            </details>
          </div>
        </div>
      </header>

      <!-- HERO -->
      <section id="profile" class="wrap hero">
        <div class="hero-main">
          <div class="boot rule-row" style="animation-delay: 0.1s">
            <span>[ FORWARD DEPLOYED ]</span>
            <span class="ticks"></span>
            <span>AUSTRALIA · REMOTE / ON-SITE</span>
          </div>
          <h1 id="name" aria-label="Denis Tsoi">DENIS
TSOI</h1>
          <p class="boot hero-tag" style="animation-delay: 0.3s">
            I embed with customers and turn rough specs into systems that run in
            production for years.
          </p>
          <p class="boot hero-body" style="animation-delay: 0.4s">
            10+ years shipping mobile, web and AI products across banks, fintech
            and startups — from Staff Engineer at a Hong Kong virtual bank to
            Co-Founder/CTO building private LLM infrastructure. Before code, I
            worked a dealing desk, so I'm at home in front of customers.
          </p>
          <div class="boot cta-row" style="animation-delay: 0.5s">
            <a href="#contact" class="btn btn-solid">
              GET IN TOUCH
              <svg width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5"
                ><path d="M0 5h16M12 1l4 4-4 4"></path></svg
              >
            </a>
            <a href={linkedin} class="btn btn-line">VIEW CV ON LINKEDIN</a>
          </div>
          <div class="boot stats" style="animation-delay: 0.6s">
            <div class="stat">
              <span class="k">YEARS SHIPPING</span>
              <span class="v" style="font-size: 20px">10+</span>
            </div>
            <div class="stat">
              <span class="k">DOMAINS</span>
              <span class="v">BANKING · INSURTECH · AI</span>
            </div>
          </div>
        </div>

        <aside class="boot brief" style="animation-delay: 0.35s">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
          <div class="brief-head">
            <span>DEPLOYMENT BRIEF</span>
            <span>01/01</span>
          </div>
          <div class="brief-list">
            {
              brief.map((b) => (
                <div class="brief-item">
                  <span class="k">{b.k}</span>
                  <span class="v">{b.v}</span>
                </div>
              ))
            }
          </div>
          <a href="#contact" data-u={emailUser} data-d={emailDomain} class="btn btn-solid btn-block">
            BOOK AN INTRO CALL
            <svg width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5"
              ><path d="M0 5h16M12 1l4 4-4 4"></path></svg
            >
          </a>
        </aside>
      </section>

      <!-- WHY ME -->
      <section id="why" class="wrap sec scan">
        <div class="sec-head">
          <span class="sec-num">01</span>
          <h2>WHY I FIT FDE</h2>
          <span class="draw ticks"></span>
          <span class="sec-meta">SPEC → PRODUCTION</span>
        </div>
        <div class="rv why">
          {
            why.map((w) => (
              <div class="why-col">
                <div class="why-tag">
                  <span>{w.tag}</span>
                  <span>{w.id}</span>
                </div>
                <p class="why-head">{w.head}</p>
                <p class="why-body">{w.body}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- DEPLOYMENTS -->
      <section id="work" class="wrap sec scan">
        <div class="sec-head">
          <span class="sec-num">02</span>
          <h2>SELECTED DEPLOYMENTS</h2>
          <span class="draw ticks"></span>
          <span class="sec-meta">AI · BANK · CLIENT</span>
        </div>
        <div class="rv cards">
          {
            deployments.map((d, i) => (
              <article class="card">
                <div class="card-head">
                  <span>{d.label}</span>
                  <span>{d.years}</span>
                </div>
                <div class="card-fig">
                  <div class={`dimg d${i + 1}`} aria-hidden="true" />
                  <span class="fig-label">{d.fig}</span>
                </div>
                <div class="card-body">
                  <h3>{d.title}</h3>
                  <div class="card-rows">
                    <div><span class="k">CONTEXT</span><span>{d.context}</span></div>
                    <div><span class="k">DID</span><span>{d.did}</span></div>
                    <div><span class="k">OUTCOME</span><span>{d.outcome}</span></div>
                  </div>
                  <div class="tags">
                    {d.tags.map((t) => <span>{t}</span>)}
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <!-- EXPERIENCE TIMELINE -->
      <section id="experience" class="wrap sec scan">
        <div class="sec-head">
          <span class="sec-num">03</span>
          <h2>EXPERIENCE</h2>
          <span class="draw ticks"></span>
          <a class="ul sec-meta sec-link" href={linkedin}>FULL HISTORY ON LINKEDIN</a>
        </div>
        <div class="rv timeline">
          {
            experience.map((x, i) => (
              <div class="xrow">
                <span aria-hidden="true" class:list={["node", { current: i === 0 }]} />
                <span class="x-when">{x.when}</span>
                <span class="x-role"><span class="mk">▸ </span>{x.role}</span>
                <span class="x-org">{x.org}</span>
                <span class="x-body">{x.body}</span>
              </div>
            ))
          }
        </div>
      </section>

      <!-- COMMUNITY -->
      <section id="community" class="wrap sec scan">
        <div class="sec-head">
          <span class="sec-num">04</span>
          <h2>COMMUNITY</h2>
          <span class="draw ticks"></span>
          <span class="sec-meta">TEACHING · ORGANISING · SPEAKING</span>
        </div>
        <p class="sec-intro">
          Explaining technology so people can use it is half of forward-deployed
          work. I've done it outside the day job for over a decade: teaching
          refugees in Hong Kong, organising the city's developer meetups, and
          speaking at them.
        </p>
        <div class="rv cards">
          {
            teaching.map((c, i) => (
              <article class="card card-wide">
                <div class="card-head">
                  <span>{c.label}</span>
                  <span>{c.years}</span>
                </div>
                <div class="card-fig">
                  <div class={`dimg d${i + 4}`} aria-hidden="true" />
                  <span class="fig-label">{c.fig}</span>
                </div>
                <div class="card-body">
                  <h3>{c.title}</h3>
                  <p class="card-text">{c.body}</p>
                  <div class="tags tags-end">
                    {c.tags.map((t) => <span>{t}</span>)}
                  </div>
                </div>
              </article>
            ))
          }
        </div>

        <div class="rv sub">
          <div class="sub-head">
            <span>ORGANISING</span>
            <span class="sub-rule"></span>
            <span>2014–2024</span>
          </div>
          <article class="card org">
            <div class="card-fig org-fig">
              <div class="dimg d6" aria-hidden="true" />
              <span class="fig-label">FIG. C3 — MEETUP NIGHT</span>
            </div>
            <div class="org-list">
              {
                organising.map((o) => (
                  <div class="xrow org-row">
                    <span class="org-when">{o.when}</span>
                    <div class="org-main">
                      <span class="org-role">{o.role}</span>
                      <span class="org-name">{o.org}</span>
                      <span>{o.body}</span>
                    </div>
                  </div>
                ))
              }
            </div>
          </article>
        </div>

        <div class="rv sub">
          <div class="sub-head">
            <span>SPEAKING</span>
            <span class="sub-rule"></span>
            <span>11 TALKS &amp; WORKSHOPS · 2013–2017</span>
          </div>
          <article class="talks">
            <div class="talks-head">
              <div class="org-main">
                <span class="talks-role">Speaker</span>
                <span class="org-name">HONG KONG WEB DEVELOPERS (HKWD) · CODE CONF</span>
              </div>
              <a class="ul sec-meta sec-link" href={talksUrl}>
                ALL SLIDES
                <svg width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"
                  ><path d="M0 5h16M12 1l4 4-4 4"></path></svg
                >
              </a>
            </div>
            <div class="talk-list">
              <a class="talk talk-feature" href={codeconf.href}>
                <span class="talk-year">{codeconf.year}</span>
                <span class="talk-main">
                  <span class="talk-title">{codeconf.title}</span>
                  <span class="talk-desc">{codeconf.body}</span>
                </span>
                <span class="talk-kind">{codeconf.kind}</span>
                <svg width="14" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M0 5h16M12 1l4 4-4 4" />
                </svg>
              </a>
              {
                talks.map((t) => (
                  <a class="talk" href={talksUrl + t.slug}>
                    <span class="talk-year">{t.year}</span>
                    <span class="talk-main">
                      <span class="talk-title">{t.title}</span>
                      <span class="talk-desc">{t.desc}</span>
                    </span>
                    <span class="talk-kind">{t.kind}</span>
                    <svg width="14" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <path d="M0 5h16M12 1l4 4-4 4" />
                    </svg>
                  </a>
                ))
              }
            </div>
          </article>
        </div>
      </section>

      <!-- CONTACT -->
      <section id="contact" class="wrap sec scan contact-sec">
        <div class="rv contact">
          <div class="contact-main">
            <span class="eyebrow">05 — READY TO DEPLOY</span>
            <h2>AVAILABLE Q4 2026</h2>
            <p>
              Looking for Forward Deployed Engineer roles at AI and fintech
              platforms. Got a customer with a rough spec? I'll get it to
              production.
            </p>
            <a href="#contact" data-u={emailUser} data-d={emailDomain} class="btn btn-inv">
              EMAIL ME
              <svg width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5"
                ><path d="M0 5h16M12 1l4 4-4 4"></path></svg
              >
