  },
  {
    when: "2016–2018",
    role: "Software Engineer",
    org: "ENERGYBOX — IOT / ENERGY — HONG KONG",
    body: "On-premise IoT energy monitoring and compliance; end-to-end QA for site reliability.",
  },
  {
    when: "2013–2016",
    role: "Developer",
    org: "SEED ALPHA, MAKIBLE, IMAGINATION — FINTECH, E-COMMERCE, DIGITAL AGENCY — HONG KONG",
    body: "Financial research app and chatbot for institutional investors; e-commerce; a touch-table interface for Pacific Place.",
  },
  {
    when: "2010–2013",
    role: "Account Exec → Senior Dealer",
    org: "ACETOP, CHANCELLOR — PRECIOUS METALS — HONG KONG",
    body: "Client-facing sales and precious metals OTC dealing before moving into engineering.",
  },
];

const teaching = [
  {
    label: "C-01 · REFUGEEK · BSD ACADEMY",
    years: "2018",
    fig: "FIG. C1 — CODE, THEN RESETTLE",
    title: "Teaching code to refugees",
    body: "Taught web development to refugees in Hong Kong through Refugeek, BSD Academy's follow-on programme that prepares students for the job market wherever they're resettling next.",
    tags: ["INSTRUCTOR", "WEB DEV", "ADULT LEARNERS"],
  },
  {
    label: "C-02 · GRASSROOTS FUTURE · OPERATION SANTA CLAUS",
    years: "2025",
    fig: "FIG. C2 — CARDBOARD ROBOT",
    title: "Te(a)ch at the Grassroots: 10-week robotics course",
    body: "Designed and taught a 10-week programming course for refugee kids in Hong Kong, as part of Operation Santa Claus: a class of 12 across two age groups (under 11 and 11–16). Sourced, funded and customised the hardware, and built the project work around cardboard robotics. Volunteering with Grassroots Future since 2020.",
    tags: ["COURSE DESIGN", "HARDWARE", "KIDS 6–16"],
  },
];

const organising = [
  {
    when: "2019–2024",
    role: "Core Organiser",
    org: "HONG KONG GOLANG MEETUP GROUP",
    body: "Core organiser of Hong Kong's Go community for 4+ years.",
  },
  {
    when: "2017–2018",
    role: "Organiser",
    org: "THINK HK — UX DESIGN MEETUP",
    body: "Curated speakers and grew an invite-only mailing list to 100+ subscribers.",
  },
  {
    when: "2014–2018",
    role: "Co-Organiser",
