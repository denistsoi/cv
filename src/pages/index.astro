  },
];

const talksUrl = "https://denistsoi.github.io/talks/";
const codeconf = {
  year: "2017",
  title: "From Junior to Senior Developer: Lone Wolf to Wolf Pack",
  kind: "TALK · CODE CONF HK",
  href: "https://hongkong.codeconf.io/2017/",
  body: "What makes a successful senior developer, frameworks to self-evaluate your career progression, and how to form \"packs\" that shape company culture and build sustainable support networks.",
};
const talks = [
  {
    year: "2017",
    title: "UI/UX: Mobile First",
    kind: "TALK · FINHACK",
    slug: "2017-ux-finhack/",
    desc: "From skeuomorphism to flat design, principles for good mobile and desktop UX, and when to break the rules, for hackathon teams in fintech, insurance and regtech.",
  },
  {
    year: "2017",
    title: "Docker Workshop",
    kind: "WORKSHOP",
    slug: "2017-devops/",
    desc: "Hands-on from hello-world to networked containers, Docker Compose, and scaling a service across a Docker Swarm.",
  },
  {
    year: "2017",
    title: "Git Workshop",
    kind: "WORKSHOP · ENERGYBOX",
    slug: "2017-git/",
    desc: "Git from the terminal for the team: init, clone, commit, amend, reset, remotes and tagging releases.",
  },
  {
    year: "2016",
    title: "Easy as Pi",
    kind: "ONGOING PROJECT",
    slug: "2016-easy-as-pi/",
    desc: "DevOps 101 on a Raspberry Pi cluster: building the rig, ARM distros like Hypriot, and untangling Docker, Kubernetes and orchestration jargon.",
  },
  {
    year: "2016",
    title: "Laravel Setup",
    kind: "TALK",
    slug: "2016-laravel/",
    desc: "Setting up PHP, Composer and Laravel on macOS, written from a front-end and Node developer's point of view.",
  },
  {
    year: "2016",
    title: "Maps",
    kind: "TALK",
    slug: "2016-maps/",
    desc: "Reviewing web mapping tools (Cesium, Mapbox, Deck.gl, D3, Three.js and more) and choosing a renderer that conveys meaning without overloading the viewer.",
  },
  {
    year: "2014",
    title: "JS 102",
    kind: "TALK",
    slug: "2014-js102/",
    desc: "For junior developers: objects, constructors and the prototype pattern, building up to a small jQuery-style library.",
  },
  {
    year: "2014",
    title: "Sass",
    kind: "TALK · WOMEN WHO CODE HK",
    slug: "2014-sass",
    desc: "Sass as CSS on steroids: nesting, variables, mixins, extends and partials, part of a front-end series.",
  },
  {
    year: "2013",
    title: "WTF CSS3D",
